{
  "format": 1,
  "orientation": "portrait",
  "name": "Donut Joe's Pelham: case board (internal spec, DP-11)",
  "notes": "From the DP-06 mockup. Items, prices, hours, address and exit from donutjoescoffee.com (checked 2026-10-07); maple bacon 'first in Alabama' from Bham Now. Internal spec only: not for a public ad without the owner's permission. Photos come with E1b.",
  "grid": { "cols": 12, "rows": 24, "gap": 16, "margin": 40 },
  "viewing": { "inches": 43, "metres": 3 },
  "theme": {
    "palette": {
      "bg": "#fff7ec", "ink": "#2b1a12", "muted": "#7a6455",
      "accent": "#c0392b", "onAccent": "#ffffff",
      "panel": "#2b1a12", "onPanel": "#fff7ec",
      "highlight": "#f0b45a", "onHighlight": "#2b1a12",
      "line": "#e8d9c4"
    },
    "fonts": { "display": "Fraunces", "body": "Instrument Sans" }
  },
  "blocks": [
    { "id": "logo", "type": "logo", "at": { "col": 1, "row": 1, "w": 7, "h": 3 },
      "style": { "size": "huge", "valign": "middle" }, "content": { "text": "Donut Joe's" } },
    { "id": "hours", "type": "hours", "at": { "col": 8, "row": 1, "w": 5, "h": 3 },
      "style": { "size": "m", "align": "right", "valign": "middle" },
      "content": { "hours": [ { "days": [2, 3, 4, 5, 6], "open": "06:00", "close": "18:00" } ], "note": "I-65 · Exit 242" } },
    { "id": "hero", "type": "photo", "at": { "col": 1, "row": 4, "w": 12, "h": 7 },
      "style": { "surface": "panel", "radius": "l", "size": "xl", "font": "display" },
      "content": { "alt": "Maple Bacon donuts on the tray", "caption": "Maple Bacon", "line": "The one that started it: the first maple bacon donut in Alabama" } },
    { "id": "hero-price", "type": "price", "at": { "col": 10, "row": 5, "w": 3, "h": 3 }, "layer": 1,
      "style": { "surface": "highlight", "size": "xl", "tilt": 6, "shadow": true },
      "content": { "label": "Each", "price": "$1.89" } },
    { "id": "fall", "type": "items", "at": { "col": 1, "row": 11, "w": 12, "h": 5 },
      "style": { "surface": "accent", "radius": "l", "size": "m", "pad": "l" },
      "when": { "dates": { "from": "2026-09-15", "to": "2026-11-30" } },
      "content": { "heading": "This fall only · Pumpkin season", "leaders": true, "items": [
        { "name": "Caramel Apple Donut", "price": "$1.89", "tags": ["seasonal"] },
        { "name": "Pumpkin Spice Cake", "line": "Cream cheese icing", "price": "$1.89", "tags": ["seasonal"] },
        { "name": "Pumpkin Spice Latte", "price": "$4.99" } ] } },
    { "id": "daily", "type": "items", "at": { "col": 1, "row": 16, "w": 12, "h": 4 },
      "style": { "size": "m" },
      "content": { "heading": "Handmade every morning", "price": "$1.89 each", "columns": 2, "items": [
        { "name": "Devil's Food Chocolate" }, { "name": "Banana Cream Pie" },
        { "name": "Blueberry Cake" }, { "name": "Caramel Raised" },
        { "name": "Chocolate Iced Raised" }, { "name": "Maple Bacon", "tags": ["favorite"] } ] } },
    { "id": "more", "type": "items", "at": { "col": 1, "row": 20, "w": 12, "h": 3 },
      "style": { "size": "m" },
      "content": { "leaders": true, "items": [
        { "name": "Classic Apple Fritter", "price": "$4.49" }, { "name": "Cinnamon Sugar Holes", "price": "$2.99" },
        { "name": "Smokey Joe sandwich", "price": "Ask" }, { "name": "Coffee, by the pound", "price": "$19.99" } ] } },
    { "id": "foot-morning", "type": "text", "at": { "col": 1, "row": 23, "w": 8, "h": 2 },
      "style": { "surface": "panel", "radius": "m", "size": "m", "pad": "m", "valign": "middle" },
      "when": { "from": "06:00", "to": "11:00" },
      "content": { "body": "Fresh coffee all morning · Family owned · 3199 Lee St, Pelham" } },
    { "id": "foot", "type": "text", "at": { "col": 1, "row": 23, "w": 8, "h": 2 },
      "style": { "surface": "panel", "radius": "m", "size": "m", "pad": "m", "valign": "middle" },
      "when": [ { "from": "00:00", "to": "06:00" }, { "from": "11:00", "to": "24:00" } ],
      "content": { "body": "Family owned · 3199 Lee St, Pelham" } },
    { "id": "now", "type": "clock", "at": { "col": 9, "row": 23, "w": 2, "h": 2 },
      "style": { "surface": "panel", "radius": "m", "size": "l", "align": "center", "valign": "middle" }, "content": { "show": "time" } },
    { "id": "weather", "type": "weather", "at": { "col": 11, "row": 23, "w": 2, "h": 2 },
      "style": { "surface": "panel", "radius": "m", "size": "l", "align": "center", "valign": "middle" }, "content": {} }
  ]
}
