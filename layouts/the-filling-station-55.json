        { "image": "img:chicken-wings", "alt": "Chicken wings", "caption": "Chicken Wings", "line": "Tossed in your favorite sauce", "price": "$13" },
        { "image": "img:station-burger", "alt": "A bacon cheeseburger with fries", "caption": "Filling Station Burger", "line": "8 oz charbroiled, your cheese & two toppings", "price": "$17" },
        { "image": "img:tiramisu", "alt": "Tiramisu", "caption": "Tiramisu", "line": "Espresso-soaked lady fingers & Italian cream", "price": "$9" }
